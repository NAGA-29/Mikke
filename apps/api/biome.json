{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "root": true,
  "files": { "includes": ["src/**", "test/**", "scripts/**", "*.ts", "*.json", "!**/node_modules"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" } },
  "linter": {
    "enabled": true,
    "rules": {
      "style": { "useTemplate": "off", "noNonNullAssertion": "off" }
    }
  },
  "overrides": [{ "includes": ["test/**"], "linter": { "rules": { "suspicious": { "noExplicitAny": "off" } } } }],
  "assist": { "enabled": false }
}
