{
  "name": "@mikke/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "token": "tsx scripts/issue-token.ts",
    "test": "vitest run",
    "mcp": "node --import tsx src/mcp/stdio.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "@modelcontextprotocol/sdk": "1.32.2",
    "hono": "4.13.18",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
