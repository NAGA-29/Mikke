{
  "name": "mikke",
  "private": true,
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.17"
  },
  "scripts": {
    "migrate": "pnpm --filter @mikke/api migrate",
    "dev": "pnpm --filter @mikke/api dev",
    "dev:web": "pnpm --filter @mikke/web dev",
    "test": "pnpm --filter @mikke/api test",
    "test:e2e": "pnpm --filter @mikke/e2e test",
    "typecheck": "pnpm -r typecheck",
    "prepare": "husky",
    "check:api": "pnpm --filter @mikke/api check",
    "format:api": "pnpm --filter @mikke/api format"
  },
  "devDependencies": {
    "husky": "9.1.7"
  }
}
